# ─────────────────────────────────────────────────────────────────────────────
# AI HR System — environment variables
# Copy to .env and fill in. Every variable is validated at boot (src/config/env.schema.ts);
# the app refuses to start if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=3000
API_PREFIX=api                       # all routes served under /<API_PREFIX>/v1
APP_NAME="HR System"                 # shown in emails / Slack messages
APP_URL=http://localhost:3000        # public base URL (used in emails / links)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173   # comma-separated; "*" allowed in dev only
LOG_LEVEL=debug                      # fatal | error | warn | info | debug | trace

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hr
DB_PASSWORD=hr
DB_NAME=hr_system
DB_SSL=false                         # true for managed providers that require TLS
DB_LOGGING=false                     # log every SQL query (dev only)

# ── Redis (cache, rate limiting, BullMQ) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Background workers (BullMQ) ─────────────────────────────────────────────
WORKERS_ENABLED=true                 # false = this instance only enqueues (API-only nodes)
NOTIFICATIONS_CONCURRENCY=5
REMINDERS_CRON=0 8 * * *             # daily task-reminder digest (UTC)

# ── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_ENABLED=true                # false only for e2e tests; refused in production
THROTTLE_TTL_MS=60000                # window size
THROTTLE_LIMIT=100                   # requests per window per IP

# ── Auth / JWT (stage 1) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d

# ── MFA & lockout ───────────────────────────────────────────────────────────
MFA_ENCRYPTION_KEY=change-me-mfa-key-at-least-32-chars   # openssl rand -base64 48; changing it voids every enrolled authenticator
MFA_REQUIRED_ROLES=ADMIN,HR_MANAGER  # must enrol before using the API; empty = optional for everyone
LOGIN_MAX_ATTEMPTS=5                 # failed password/MFA attempts before lockout
LOGIN_LOCKOUT_MINUTES=15

# ── Payroll ─────────────────────────────────────────────────────────────────
PAYROLL_CURRENCY=NGN                 # company default; structures may override
PAYROLL_CALCULATOR=nigeria           # nigeria (PAYE, 8% pension, 2.5% NHF, pro-rating) | simple (contractual lines only)

# ── Seeding ─────────────────────────────────────────────────────────────────
# npm run seed / seed:demo — local dev only. In production, `npm run seed:admin`
# creates the first ADMIN from these two (skipped if the email exists).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
DEMO_PASSWORD=DemoPassw0rd!          # password for every *@demo.local user (seed:demo)

# ── File storage (documents, profile photos) ─────────────────────────────────
STORAGE_DRIVER=memory                # cloudinary | memory (memory = dev/test only, nothing persists)
CLOUDINARY_CLOUD_NAME=               # required when STORAGE_DRIVER=cloudinary
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=10
DOWNLOAD_URL_TTL_SECONDS=300         # signed download links expire after this

# ── Email (SMTP, stage 3) ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025                       # e.g. Mailpit in docker-compose
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HR System <no-reply@example.com>"

# ── Slack (stage 3) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#hr-notifications

# ── AI: knowledge base + assistant ──────────────────────────────────────────
AI_DRIVER=fake                       # live | fake (fake = no external calls; tests/offline dev)
HF_API_TOKEN=                        # required for embeddings when AI_DRIVER=live (Anthropic has no embeddings API)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384             # must match the embedding model AND the pgvector column
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.3   # chat backup only
ANTHROPIC_API_KEY=                   # primary chat provider
ANTHROPIC_MODEL=claude-haiku-5-5     # request is shaped per model (thinking/effort/fallback)
ANTHROPIC_EFFORT=medium              # low | medium | high | xhigh | max (ignored by pre-4.6 models)
OPENAI_API_KEY=                      # optional
OPENAI_MODEL=gpt-4o
AI_CHAT_PROVIDERS=anthropic,huggingface,openai   # fallback order; providers without a key are skipped
AI_MAX_OUTPUT_TOKENS=8192            # includes Claude's thinking tokens
AI_DAILY_MESSAGE_LIMIT=50            # assistant questions per user per UTC day; 0 = unlimited
AI_SIMILARITY_FLOOR=0.25             # ignore chunks below this cosine similarity
AI_RETRIEVAL_TOP_K=6

# ── Production deploy (docker-compose.prod.yml only) ────────────────────────
DOMAIN=                              # e.g. hr.example.com — Caddy gets a Let's Encrypt cert for it
ACME_EMAIL=                          # certificate expiry notices
HTTP_PORT=80
HTTPS_PORT=443

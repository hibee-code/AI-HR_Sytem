# ─────────────────────────────────────────────────────────────────────────────
# AI HR System — environment variables
# Copy to .env and fill in. Every variable is validated at boot (src/config/env.schema.ts);
# the app refuses to start if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
API_PREFIX=
APP_NAME=
APP_URL=
CORS_ORIGINS= 
LOG_LEVEL=                     

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=                         
DB_LOGGING=

# ── Redis (cache, rate limiting, BullMQ) ────────────────────────────────────
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# ── Background workers (BullMQ) ─────────────────────────────────────────────
WORKERS_ENABLED=
NOTIFICATIONS_CONCURRENCY=
REMINDERS_CRON=

# ── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_ENABLED=
THROTTLE_TTL_MS=
THROTTLE_LIMIT=

# ── Auth / JWT (stage 1) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=

# ── MFA & lockout ───────────────────────────────────────────────────────────
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=
MFA_TOTP_WINDOW=
LOGIN_MAX_ATTEMPTS=
LOGIN_LOCKOUT_MINUTES=

# ── Payroll ─────────────────────────────────────────────────────────────────
PAYROLL_CURRENCY= 
PAYROLL_CALCULATOR=    

# ── Seeding ─────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
DEMO_PASSWORD=

# ── File storage (documents, profile photos) ─────────────────────────────────
STORAGE_DRIVER=
CLOUDINARY_CLOUD_NAME=            
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=10
DOWNLOAD_URL_TTL_SECONDS=
# ── Email (SMTP, stage 3) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=                       
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ── Slack (stage 3) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# ── AI: knowledge base + assistant ──────────────────────────────────────────
AI_DRIVER=
HF_API_TOKEN=                     
HF_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
HF_CHAT_MODEL=
ANTHROPIC_API_KEY=                 
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
OPENAI_API_KEY=                      
OPENAI_MODEL=
AI_CHAT_PROVIDERS=
AI_MAX_OUTPUT_TOKENS=           
AI_DAILY_MESSAGE_LIMIT=         
AI_SIMILARITY_FLOOR=         
AI_RETRIEVAL_TOP_K=6

# ── Production deploy (docker-compose.prod.yml only) ────────────────────────
DOMAIN=                             
ACME_EMAIL=            
HTTP_PORT=
HTTPS_PORT=

# ── e2e test stack (scripts/e2e-docker.sh → docker-compose.test.yml) ────────
# Optional. Empty passwords are generated randomly for each run (CI needs none);
# set them to keep the same credentials across KEEP_INFRA=1 reruns.
TEST_DB_USERNAME=hr_test
TEST_DB_PASSWORD=
TEST_DB_NAME=hr_system_test
TEST_REDIS_PASSWORD=
REDIS_MAXMEMORY=
BACKUP_KEEP_DAYS=
BACKUP_HOUR_UTC=
BACKUP_UPLOAD_CMD=
RETENTION_AUDIT_DAYS=
RETENTION_AI_CONVERSATION_DAYS=
RETENTION_AI_USAGE_DAYS=
RETENTION_NOTIFICATION_LOG_DAYS=
RETENTION_CANDIDATE_DAYS=
RETENTION_CRON=
AI_REDACT_PII=
AI_DAILY_LIMIT_OVERRIDES=

# ─────────────────────────────────────────────────────────────────────────────
# AI HR System — environment variables
# Copy to .env and fill in. Every variable is validated at boot (src/config/env.schema.ts);
# the app refuses to start if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
PORT=3000
API_PREFIX=api                       # all routes served under /<API_PREFIX>/v1
APP_URL=http://localhost:3000        # public base URL (used in emails / links)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173   # comma-separated; "*" allowed in dev only
LOG_LEVEL=debug                      # fatal | error | warn | info | debug | trace

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=hr
DB_PASSWORD=hr
DB_NAME=hr_system
DB_SSL=false                         # true for managed providers that require TLS
DB_LOGGING=false                     # log every SQL query (dev only)

# ── Redis (cache, rate limiting, BullMQ) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000                # window size
THROTTLE_LIMIT=100                   # requests per window per IP

# ── Auth / JWT (stage 1) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_TTL=7d

# ── Cloudinary (stage 6) ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP, stage 3) ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025                       # e.g. Mailpit in docker-compose
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HR System <no-reply@example.com>"

# ── Slack (stage 3) ─────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#hr-notifications

# ── AI / Hugging Face (stage 9–10) ──────────────────────────────────────────
HF_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # 384-dim
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
